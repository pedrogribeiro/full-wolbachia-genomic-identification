#!/bin/bash
# Purpose: filter BLASTX results by bitscore and percent identity to define
#          confident presence of Wolbachia proteins in assembled contigs.
# Note: this is an array job — one job per sample in samples.txt.
# Note: set SUPERGROUP to "A" or "B" to process the corresponding supergroup.
#       Submit separately for each supergroup.
# Note: this is an HPC/PBS example and paths should be adapted to the local system.

##### define pbs settings #####

#PBS -N filter_blastx
#PBS -l select=1:ncpus=1:mem=4gb:scratch_local=5gb
#PBS -l walltime=1:00:00
#PBS -o filter_blastx.out
#PBS -e filter_blastx.err
#PBS -J 1-84

##### define variables #####

SUPERGROUP="A"                      # toggle between "A" and "B" — resubmit for each
PROJECT_DIR="/storage/brno12-cerit/home/pedroribeiro/wolbachia_eudaminae"
LIST="${PROJECT_DIR}/resources/samples.txt"
INPUT_DIR="${PROJECT_DIR}/out_blastx_supergroup${SUPERGROUP}"
OUTPUT_DIR="${PROJECT_DIR}/out_blastx_filtered_supergroup${SUPERGROUP}"
BITSCORE_MIN=300
EVALUE_MAX="1.0e-10"
PIDENT_MIN=95

##### define substitution list for array variables #####

SAMPLE="$(sed -n "${PBS_ARRAY_INDEX}p" "${LIST}")"

##### system specific definitions #####

trap 'clean_scratch' TERM EXIT
cd "$SCRATCHDIR" || exit 1
export TMPDIR="$SCRATCHDIR"

##### copy necessary files to scratch #####

rsync -a "${INPUT_DIR}/${SAMPLE}.${SUPERGROUP}.tsv" "${SCRATCHDIR}"

##### step 1: filter by bitscore and e-value #####

awk -F'\t' -v bs="$BITSCORE_MIN" -v ev="$EVALUE_MAX" \
  '$10 > bs && $9 < ev' \
  "${SAMPLE}.${SUPERGROUP}.tsv" > tmp_filter1.tsv

##### step 2: filter by percent identity #####

awk -F'\t' -v pi="$PIDENT_MIN" \
  '$12 > pi' \
  tmp_filter1.tsv \
  > "${OUTPUT_DIR}/${SAMPLE}.${SUPERGROUP}.filtered.tsv"
