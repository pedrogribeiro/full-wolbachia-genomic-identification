#!/bin/bash
# Purpose: build protein BLAST database from Wolbachia reference proteomes and
#          search assembled contigs per sample against it (BLASTX).
# Note: this is an array job — one job per sample in samples.txt.
# Note: set SUPERGROUP to "A" or "B" to process the corresponding supergroup.
#       Submit separately for each supergroup.
# Note: concatenated protein FASTA (superA + superB) must be placed in resources/references/.
# Note: the database is built only once (guarded by a check on the index file).
# Note: this is an HPC/PBS example and paths should be adapted to the local system.

##### define pbs settings #####

#PBS -N blastx_validation
#PBS -l select=1:ncpus=4:mem=16gb:scratch_local=20gb
#PBS -l walltime=12:00:00
#PBS -o blastx_validation.out
#PBS -e blastx_validation.err
#PBS -J 1-84

##### define variables #####

SUPERGROUP="A"                      # toggle between "A" and "B" — resubmit for each
PROJECT_DIR="/storage/brno12-cerit/home/pedroribeiro/wolbachia_eudaminae"
LIST="${PROJECT_DIR}/resources/samples.txt"
REF_DIR="${PROJECT_DIR}/resources/references"
PROT_FASTA="${REF_DIR}/wolbachiaProteinConcat.fasta"
DB_PREFIX="${REF_DIR}/wolbProteinDB"
CONTIGS_DIR="${PROJECT_DIR}/out_spades_supergroup${SUPERGROUP}"
OUTPUT_DIR="${PROJECT_DIR}/out_blastx_supergroup${SUPERGROUP}"
THREADS="4"

##### define substitution list for array variables #####

SAMPLE="$(sed -n "${PBS_ARRAY_INDEX}p" "${LIST}")"

##### system specific definitions #####

trap 'clean_scratch' TERM EXIT
cd "$SCRATCHDIR" || exit 1
export TMPDIR="$SCRATCHDIR"

##### activate environment #####

module load blast+

##### build protein database (only once — skipped if index already exists) #####

if [ ! -f "${DB_PREFIX}.phr" ]; then
  rsync -a "$PROT_FASTA" "${SCRATCHDIR}"
  makeblastdb \
    -in "wolbachiaProteinConcat.fasta" \
    -out "$DB_PREFIX" \
    -parse_seqids \
    -dbtype prot
fi

##### copy necessary files to scratch #####

rsync -a "${CONTIGS_DIR}/${SAMPLE}/contigs.fasta" "${SCRATCHDIR}/${SAMPLE}.fasta"
rsync -a "${DB_PREFIX}"* "${SCRATCHDIR}"

##### run blastx #####

blastx \
  -db "wolbProteinDB" \
  -query "${SAMPLE}.fasta" \
  -num_threads "$THREADS" \
  -out "${OUTPUT_DIR}/${SAMPLE}.${SUPERGROUP}.tsv" \
  -outfmt "6 qseqid qlen sseqid slen qstart qend sstart send evalue bitscore length pident nident mismatch gapopen gaps qseq sseq delim=;"
