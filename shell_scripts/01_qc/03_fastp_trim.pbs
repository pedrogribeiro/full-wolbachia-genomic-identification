#!/bin/bash
# Purpose: trim and filter raw reads with Fastp for each sample.
# Note: this is an array job — one job per sample in samples.txt.
# Note: this is an HPC/PBS example and paths should be adapted to the local system.

##### define pbs settings #####

#PBS -N fastp_trim
#PBS -l select=1:ncpus=4:mem=16gb:scratch_local=40gb
#PBS -l walltime=8:00:00
#PBS -o fastp_trim.out
#PBS -e fastp_trim.err
#PBS -J 1-84

##### define variables #####

PROJECT_DIR="/storage/brno12-cerit/home/pedroribeiro/wolbachia_eudaminae"
LIST="${PROJECT_DIR}/resources/samples.txt"
RAW_DIR="${PROJECT_DIR}/data/raw"
OUTPUT_DIR="${PROJECT_DIR}/out_fastp"

##### define substitution list for array variables #####

SAMPLE="$(sed -n "${PBS_ARRAY_INDEX}p" "${LIST}")"

##### system specific definitions #####

trap 'clean_scratch' TERM EXIT
cd "$SCRATCHDIR" || exit 1
export TMPDIR="$SCRATCHDIR"

##### activate environment #####

module load fastp

##### copy necessary files to scratch #####

rsync -a "${RAW_DIR}/${SAMPLE}.R1.fq.gz" "${SCRATCHDIR}"
rsync -a "${RAW_DIR}/${SAMPLE}.R2.fq.gz" "${SCRATCHDIR}"

##### run fastp #####

fastp \
  -i "${SAMPLE}.R1.fq.gz" \
  -I "${SAMPLE}.R2.fq.gz" \
  -o "${OUTPUT_DIR}/${SAMPLE}.R1.fq.gz" \
  -O "${OUTPUT_DIR}/${SAMPLE}.R2.fq.gz"
