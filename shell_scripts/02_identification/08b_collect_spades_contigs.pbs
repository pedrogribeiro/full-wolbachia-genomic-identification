#!/bin/bash
# Purpose: collect SPAdes contigs.fasta outputs from per-sample subdirectories
#          into a single flat directory required by SECAPR find_target_contigs (script 13).
#          Each contig file is renamed to the sample ID to preserve identity.
# Note: run once per supergroup after all 08_spades_assembly.pbs array jobs have completed.
# Note: set SUPERGROUP to "A" or "B" to process the corresponding supergroup.
#       Submit separately for each supergroup.
# Note: this is an HPC/PBS example and paths should be adapted to the local system.

##### define pbs settings #####

#PBS -N collect_spades_contigs
#PBS -l select=1:ncpus=1:mem=4gb:scratch_local=10gb
#PBS -l walltime=1:00:00
#PBS -o collect_spades_contigs.out
#PBS -e collect_spades_contigs.err

##### define variables #####

SUPERGROUP="A"                      # toggle between "A" and "B" — resubmit for each
PROJECT_DIR="/storage/brno12-cerit/home/pedroribeiro/wolbachia_eudaminae"
LIST="${PROJECT_DIR}/resources/samples.txt"
SPADES_DIR="${PROJECT_DIR}/out_spades_supergroup${SUPERGROUP}"
OUTPUT_DIR="${PROJECT_DIR}/out_spades_supergroup${SUPERGROUP}_all"

##### system specific definitions #####

trap 'clean_scratch' TERM EXIT
cd "$SCRATCHDIR" || exit 1
export TMPDIR="$SCRATCHDIR"

##### collect contigs — rename to sample ID so SECAPR can parse sample names #####

missing=0

while IFS= read -r SAMPLE; do
  CONTIG="${SPADES_DIR}/${SAMPLE}/contigs.fasta"
  if [ ! -f "$CONTIG" ]; then
    echo "WARNING: missing contigs for ${SAMPLE} — skipping"
    missing=$((missing + 1))
    continue
  fi
  cp "$CONTIG" "${OUTPUT_DIR}/${SAMPLE}.fasta"
done < "$LIST"

##### report #####

total=$(wc -l < "$LIST")
collected=$((total - missing))
echo "Collected ${collected}/${total} contig files into ${OUTPUT_DIR}"

if [ "$missing" -gt 0 ]; then
  echo "WARNING: ${missing} sample(s) had no contigs.fasta — check SPAdes logs"
fi
